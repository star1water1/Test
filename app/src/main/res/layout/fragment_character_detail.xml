<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator" />

        <!-- Time slider section (togglable) -->
        <LinearLayout
            android:id="@+id/timeSliderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:elevation="2dp"
            android:visibility="gone">

            <!-- Toggle header -->
            <LinearLayout
                android:id="@+id/timeSliderHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/time_view"
                    android:textAppearance="@style/TextAppearance.App.BodyStrong"
                    android:textColor="@color/primary" />

                <ImageView
                    android:id="@+id/timeSliderToggleIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_down"
                    android:contentDescription="@string/toggle_time_slider" />

            </LinearLayout>

            <!-- Slider + year label -->
            <LinearLayout
                android:id="@+id/timeSliderContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/yearSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1"
                        app:trackColorActive="@color/primary"
                        app:trackColorInactive="@color/primary_light"
                        app:thumbColor="@color/primary" />

                    <TextView
                        android:id="@+id/yearLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAppearance="@style/TextAppearance.App.Title"
                        android:textColor="@color/primary"
                        android:minWidth="56dp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Min/Max year labels -->
                <LinearLayout
                    android:id="@+id/yearRangeLabels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/minYearLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/text_secondary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/maxYearLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </LinearLayout>

            <!-- Reset button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetTimeView"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/reset_time_view"
                android:visibility="gone" />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Image carousel + 대표 지정 ☆ (B-103 D7) -->
                <FrameLayout
                    android:id="@+id/imageCarouselContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/imageViewPager"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:maxHeight="300dp"
                        android:background="@color/item_background_light"
                        android:contentDescription="@string/image_carousel_desc" />

                    <!--
                        코너에 두어 이미지 탭·스와이프를 가리지 않는다. 탭 = 지금 보고 있는
                        그 장을 대표로, 다시 탭 = 해제(D7 — 1탭).
                    -->
                    <ImageButton
                        android:id="@+id/btnRepresentativeImage"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_image_badge"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_star_outline"
                        android:contentDescription="@string/representative_image_set" />

                </FrameLayout>

                <!--
                    사후 고지(D6ⓑ) — 지정한 대표를 못 찾았을 때. 앱 밖 삭제·폴더 왕복처럼
                    사전 고지가 원리적으로 불가능한 자리를 여기서 받는다.
                -->
                <TextView
                    android:id="@+id/representativeMissingNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:padding="12dp"
                    android:background="@color/item_background_light"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/text_secondary"
                    android:text="@string/representative_image_missing_notice"
                    android:visibility="gone" />

                <!-- Character name -->
                <TextView
                    android:id="@+id/detailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Headline"
                    android:textColor="@color/on_surface" />

                <!-- First Name / Last Name subtitle -->
                <TextView
                    android:id="@+id/detailFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

                <!-- Aliases (chips) -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/aliasChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />

                <!-- Novel name -->
                <TextView
                    android:id="@+id/detailNovel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/text_secondary" />

                <!-- Tags -->
                <TextView
                    android:id="@+id/detailTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                    android:visibility="gone" />

                <!-- Time view indicator (visible when slider is active) -->
                <TextView
                    android:id="@+id/timeViewIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="12dp"
                    android:background="@color/primary_light"
                    android:textColor="@color/primary_dark"
                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:visibility="gone" />

                <!-- Dynamic fields container (populated programmatically from CharacterFieldValue) -->
                <LinearLayout
                    android:id="@+id/dynamicFieldsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Standard year linkage toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/stdYearLinkSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/std_year_link_label"
                    android:visibility="gone" />

                <!-- Memo card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/memoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/memo"
                            android:textAppearance="@style/TextAppearance.App.Title"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/detailMemo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Faction membership card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/factionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/faction_belonging"
                            android:textAppearance="@style/TextAppearance.App.Title"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/factionChipGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/factionEmptyText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/faction_belonging_empty"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:paddingVertical="16dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Relationships card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/relationshipsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/relationship_label"
                                android:textAppearance="@style/TextAppearance.App.Title"
                                android:textColor="@color/primary" />

                            <!-- 보기 정렬(B-85): 기본은 수동 순서. 그때만 드래그 재정렬이 열린다. -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSortRelationships"
                                style="@style/Widget.App.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingHorizontal="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                tools:text="기본 (수동 순서)" />

                            <ImageView
                                android:id="@+id/btnAddRelationship"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:padding="12dp"
                                android:src="@drawable/ic_add"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/add_relationship" />

                        </LinearLayout>

                        <!--
                          드래그가 잠긴 사유 고지. 정렬 중에 드래그를 열어 두면 정렬된 화면의 위치가
                          그대로 저장 순서(displayOrder)로 덮여 손으로 잡아 둔 순서가 지워진다.
                          잠그는 것으로 끝내면 "왜 안 되지"가 남으므로 되돌릴 길까지 함께 적는다.
                        -->
                        <TextView
                            android:id="@+id/textRelationshipSortNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/relationship_sort_drag_locked"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/text_secondary"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/textNoRelationships"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/empty_relationship_hint"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:paddingVertical="16dp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/relationshipsRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Related events card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/related_events"
                                android:textAppearance="@style/TextAppearance.App.Title"
                                android:textColor="@color/primary" />

                            <!-- 보기 정렬(B-85) — 사건은 저장 순서가 없어 드래그와 충돌하지 않는다. -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSortEvents"
                                style="@style/Widget.App.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingHorizontal="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                tools:text="연도순" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddEvent"
                                style="@style/Widget.App.Button.Tonal"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="@string/add_event"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp" />

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/eventsRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Character individual stats card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/characterStatsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/character_stats_label"
                            android:textAppearance="@style/TextAppearance.App.Title"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/characterStatsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 명대사 card (사용자 요청 2026.08.20) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quotesCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/quotes"
                                android:textAppearance="@style/TextAppearance.App.Title"
                                android:textColor="@color/primary" />

                            <TextView
                                android:id="@+id/quotesCount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:textAppearance="@style/TextAppearance.App.BodySmall"
                                android:textColor="@color/text_secondary"
                                android:visibility="gone"
                                tools:text="4개 · 생일 1개"
                                tools:visibility="visible" />

                            <ImageView
                                android:id="@+id/btnAddQuote"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:padding="12dp"
                                android:src="@drawable/ic_add"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/add_quote_desc" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/textNoQuotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/empty_quote_hint"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:paddingVertical="16dp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/quotesRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/quoteReorderHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/quote_reorder_hint"
                            android:textSize="@dimen/text_badge"
                            android:textColor="@color/text_secondary"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- State changes card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/stateChangesCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/state_changes"
                                android:textAppearance="@style/TextAppearance.App.Title"
                                android:textColor="@color/primary" />

                            <!-- 보기 정렬(B-85) — 상태 변화도 저장 순서가 없다(DAO가 연·월·일 고정). -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSortStateChanges"
                                style="@style/Widget.App.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingHorizontal="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                tools:text="연도순" />

                            <ImageView
                                android:id="@+id/btnAddStateChange"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:padding="12dp"
                                android:src="@drawable/ic_add"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/add_state_change" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/textNoStateChanges"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/empty_state_change_hint"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:paddingVertical="16dp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/stateChangesRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_edit"
        android:contentDescription="@string/edit_button_desc" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
