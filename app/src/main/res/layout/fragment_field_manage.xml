<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/field_manage"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <LinearLayout
        android:id="@+id/emptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_settings"
            android:alpha="0.4"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/no_fields" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_fields"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_field_hint"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- 관리 대상 전환 (B-10 · 확-3): 캐릭터 필드 / 사건 필드 / 작품 필드 -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/entityTypeChipGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:selectionRequired="true"
        app:singleSelection="true"
        app:layout_constraintEnd_toStartOf="@id/btnSortFields"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCharacterFields"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/field_target_character" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipEventFields"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_target_event" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipNovelFields"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_target_novel" />

    </com.google.android.material.chip.ChipGroup>

    <!-- B-48: 보기 정렬. 대상 칩과 한 줄에 둔다 — 둘 다 "무엇을 어떻게 보는가"이고,
         정렬이 걸리면 바로 밑의 잠금 안내가 이어져 사유가 한자리에서 읽힌다. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSortFields"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:minWidth="0dp"
        android:text="@string/field_sort_view"
        android:contentDescription="@string/field_sort_view"
        app:layout_constraintBottom_toBottomOf="@id/entityTypeChipGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/entityTypeChipGroup" />

    <!-- 잠긴 사유는 화면에 적는다(B-85 선례 · 확정 7-7) — 드래그가 안 먹는 것을
         고장으로 읽지 않게 한다. 기본 정렬에서는 숨는다. -->
    <TextView
        android:id="@+id/sortLockedNotice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="@string/field_sort_drag_locked"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.App.BodySmall"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/entityTypeChipGroup"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fieldRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="88dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sortLockedNotice" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddField"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/add_field"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
