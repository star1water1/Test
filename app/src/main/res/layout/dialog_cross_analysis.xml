<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- R-25 목적문: 이 다이얼로그가 무엇을 만들어 내는지를 고르기 전에 알린다. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/purpose_cross_analysis"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/text_secondary" />

        <!-- 집계 축 (B-4): 셀 값이 캐릭터 수인지 사건 수인지를 정한다. 축이 다른 필드는 한 표에 섞이지 않는다. -->
        <TextView
            android:id="@+id/axisLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stats_cross_axis"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/text_secondary" />

        <!-- 축 선택기와 함께 숨는다(축이 하나뿐이면 고를 것이 없다) — 배선은 StatsFieldInsightFragment. -->
        <TextView
            android:id="@+id/axisPurpose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/purpose_cross_axis"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/text_secondary" />

        <Spinner
            android:id="@+id/spinnerAxis"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stats_cross_field1"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/text_secondary" />

        <Spinner
            android:id="@+id/spinnerField1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stats_cross_field2"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/text_secondary" />

        <Spinner
            android:id="@+id/spinnerField2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/filterLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_cross_filter_field"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/purpose_cross_filter"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/text_secondary" />

            <Spinner
                android:id="@+id/spinnerFilterField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/stats_cross_filter_value_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editFilterValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
