<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<!-- 툴바는 지우지 않는다 (N-1 §7-2) — 작품별 목록으로 푸시되면 뒤로가기+작품명을 보여야 한다.
         탭 루트(novelId=-1)에서만 코드가 GONE 처리해 상단을 2행으로 줄인다. 메뉴는 갖지 않는다 —
         메뉴 호스트는 아래 액션 행의 ⋮ 하나뿐이다(두 벌 게이팅은 반드시 갈린다). -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/tab_characters" />

    <!-- 액션 행 — [검색][컨트롤][⋮]. 탭 루트·푸시 양쪽에서 보이는 유일한 메뉴 호스트.
         검색창을 아이콘으로 접지 않는다: 검색은 이 화면의 주 조작이고, 접으면 1탭이 늘며 절감은 0이다. -->
    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            style="@style/Widget.App.TextInput.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:hint="@string/search"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListControls"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/controls_button"
            app:icon="@drawable/ic_tune" />

        <!-- ⋮ 통합 (N-1 §7-2) — 보충(탭 루트만)·비교·일괄 편집·순서 변경 -->
        <ImageButton
            android:id="@+id/btnListOverflow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_options"
            android:src="@drawable/ic_more_vert"
            android:scaleType="centerInside"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <!-- 활성 상태 칩 행: 프리셋(1탭 적용 보존) + 정렬 상태 + 활성 필터 -->
    <LinearLayout
        android:id="@+id/filterSortBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingBottom="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/actionRow">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/presetChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:chipSpacingHorizontal="4dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sortChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:visibility="gone" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/filterChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:singleLine="true"
                    app:chipSpacingHorizontal="4dp" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- 선택 바 (B-83) — 진입 셋(⋮ 비교하기 · ⋮ 일괄 편집 · 카드 롱프레스)이 전부 이 하나로 온다.
         종전엔 목적지마다 바가 따로 있어(batchEditBar / compareBar) 어느 문으로 들어왔는지가
         무엇을 할 수 있는지를 정했다 — 롱프레스로 들어오면 비교가 없었다. 선택을 목적지에서
         떼어내 두 실행 버튼을 나란히 두면, 고르는 순서가 '무엇을 할지 → 누구를'에서
         '누구를 → 무엇을 할지'로 바뀐다(원칙 04). -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="@color/surface"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filterSortBar">

        <ImageButton
            android:id="@+id/btnSelectionClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/selectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/batch_selected_count_zero"
            android:textAppearance="@style/TextAppearance.App.BodyStrong"
            android:paddingStart="4dp" />

        <ImageButton
            android:id="@+id/btnSelectionOverflow"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_options"
            android:src="@drawable/ic_more_vert"
            android:scaleType="centerInside"
            app:tint="?attr/colorOnSurfaceVariant" />

        <!-- 실행 둘은 토널(보조) + 채움(주)으로 위계를 준다 — 목적지가 둘이라는 것은 보이되
             어느 쪽이 기본인지는 남긴다. 텍스트 버튼을 쓰지 않은 것은 그 스타일이 다이얼로그
             액션 슬롯·인라인 링크 전용이라 styles.xml에 적혀 있기 때문이다.
             좁은 화면 대비: 둘 다 maxLines=1이고, 남는 폭은 선택 수 표기(weight=1)가 먼저 내준다. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectionCompare"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/compare_mode_label"
            android:maxLines="1"
            android:minWidth="56dp"
            android:minHeight="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectionAction"
            style="@style/Widget.App.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/batch_action"
            android:maxLines="1"
            android:minWidth="56dp"
            android:minHeight="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:enabled="false" />

    </LinearLayout>

    <!-- 생일 배너 -->
    <LinearLayout
        android:id="@+id/birthdayBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/selectionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/birthdayHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/birthdayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/birthday_banner_title"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnToggleBirthday"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_expand_less"
                android:scaleType="centerInside"
                android:contentDescription="@string/birthday_banner_title"
            app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/birthdayRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/emptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/birthdayBanner">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_character_placeholder"
            android:alpha="0.4"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/no_characters" />

        <TextView
            android:id="@+id/emptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_characters"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.App.Title" />

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_character_hint"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearFilters"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/filter_clear"
            android:visibility="gone" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/characterRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="88dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/birthdayBanner" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddCharacter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/add_character"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
