<?xml version="1.0" encoding="utf-8"?>
<!-- 루트를 NestedScrollView로 감싼다 — 액션·태그 섹션 증가로 소형 화면 오버플로 방지 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/detailSizeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.TitleLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="1.2 MB" />

        <TextView
            android:id="@+id/detailOwnerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="캐릭터 · 홍길동\n작품 · 어떤 소설" />

        <!-- 태그 섹션 — 라이브러리 태그 칩 + 편집 진입 -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/detailTagChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 링크 그룹 정보 — 링크된 이미지에만 노출 -->
        <TextView
            android:id="@+id/detailLinkInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:text="링크 그룹 · 3장" />

        <!-- 걸러낼 후보의 근거 (B-104 소비처 ⓒ) — 후보로 오른 이미지에만 노출.
             제안 옆에 근거가 없으면 앱이 지어낸 서열이 된다(원칙 02). -->
        <TextView
            android:id="@+id/detailPruneReasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="걸러낼 후보 — 12장 중 11위 · 7판" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailTagEditButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="start|center_vertical"
            android:text="@string/image_tag_edit_action" />

        <!-- AI 태그 추천 — 쓸 수 있는 프로바이더가 있을 때만 보인다(R-24).
             종전에는 선택 모드의 일괄 작업 시트가 유일한 입구였다. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailAiTagButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:visibility="gone"
            android:text="@string/image_ai_tag_action"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailAssignButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/image_assign_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailUnassignButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/image_unassign_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailUnlinkButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/image_unlink_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailFullScreenButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/image_manager_view_full" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailRecompressButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/image_manager_recompress" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailDeleteButton"
            style="@style/Widget.App.Button.Outlined.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/delete" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailCloseButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/close" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
