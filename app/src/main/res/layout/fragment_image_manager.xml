<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 헤더 — 정렬·필터는 검색 줄의 통합 버튼으로 내려갔다(캐릭터 목록과 같은 자리) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/tab_images"
            android:textAppearance="@style/TextAppearance.App.Headline"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importButton"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/image_manager_import" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/image_manager_select" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/optionsButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/image_manager_options" />
    </LinearLayout>

    <!-- 용량 요약 -->
    <TextView
        android:id="@+id/summaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textAppearance="@style/TextAppearance.App.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="총 42개 · 12.3 MB (참조 38 · 고아 4)" />

    <!-- 정리 폴더 진입 감지 배너 — 폴더에 새 이미지가 있을 때만 보인다(D5) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/organizeFolderBanner"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="정리 폴더에 새 이미지 3장" />

    <!-- 검색 + 통합 컨트롤 줄 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/image_manager_search_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:textAppearance="@style/TextAppearance.App.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 정렬(기준·방향)·묶어 보기·필터의 단일 진입점 — 종전의 정렬 팝업 + 칩 두 그룹 +
             태그 시트 버튼을 하나로 접었다(캐릭터 목록의 btnListControls와 같은 관행) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/controlsButton"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/controls_button"
            app:icon="@drawable/ic_tune" />

        <!-- 그리드 ↔ 갤러리 보기 전환 (라벨은 전환 '대상' 모드) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewModeButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/image_manager_view_gallery" />
    </LinearLayout>

    <!-- 활성 상태 칩 행: 정렬 상태(탭=방향 반전) + 활성 필터(×=그 자리 해제) + 묶어 보기.
         걸려 있는 것이 화면에 보여야 한다 — 일일이 열어 봐야 아는 상태 금지(원칙 04). -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.chip.Chip
                android:id="@+id/sortChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="크기순 ↓" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/activeFilterChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                app:singleLine="true"
                app:chipSpacingHorizontal="4dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="5dp"
            android:clipToPadding="false" />

        <!-- 갤러리뷰 모드 — 그리드와 같은 목록을 한 장씩 스와이프 (편집은 하단 오버레이) -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/galleryPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/galleryOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/galleryIndexText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="3 / 42 · img_abc.jpg" />

            <TextView
                android:id="@+id/galleryOwnerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="캐릭터 · 한서린" />

            <TextView
                android:id="@+id/galleryTagText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="태그: 은발 · 갑옷" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/galleryDetailButton"
                    style="@style/Widget.App.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/image_manager_gallery_detail" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/galleryTagButton"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/image_manager_gallery_tag" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/image_manager_empty"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 선택 모드 하단 액션 바 — 선택 모드에서만 노출 -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/colorSurfaceVariant"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/selectionCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="3개 선택" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectAllButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/image_manager_select_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionsButton"
            style="@style/Widget.App.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/image_manager_actions" />
    </LinearLayout>
</LinearLayout>
