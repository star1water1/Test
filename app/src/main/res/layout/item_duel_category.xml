<?xml version="1.0" encoding="utf-8"?>
<!--
  범주형 영향 필드의 한 칸 (B-112) — 값 둘이 맞붙은 전적.

  상성 카드(item_duel_counter)와 같은 자리에 서지만 **버튼이 없다.** 이것은 판정할 대상이
  아니라 위 후보들의 *근거*를 대는 줄이기 때문이다 — 사용자가 여기서 할 일은 읽는 것뿐이다.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/pairText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Subtitle"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/recordText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/leanText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
