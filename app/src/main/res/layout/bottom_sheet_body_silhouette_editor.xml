<?xml version="1.0" encoding="utf-8"?><!--
  실루엣 편집기 (설계 docs/body_visual_redesign_2026-07.md 5-4-4).
  높이 고정 시트 — 상단 실루엣(핸들 드래그) / 중단 부위 행(코드 생성) / 하단 🎲 패널.
  부위 행은 필드마다 파트 수가 달라 코드에서 만든다(여기 고정 행을 두면 두 벌이 된다).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 머리 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:paddingTop="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/silhouette_editor_title"
            android:textAppearance="@style/TextAppearance.App.TitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.App.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/close"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

    </LinearLayout>

    <!-- 목적문 (R-25) + 기준 고지 (P9-②) -->
    <TextView
        android:id="@+id/purposeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp"
        android:text="@string/silhouette_editor_purpose"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- 실루엣 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="55">

        <com.novelcharacter.app.ui.character.SilhouetteView
            android:id="@+id/silhouette"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleSide"
                style="@style/Widget.App.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:text="@string/silhouette_view_side" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleOverlay"
                style="@style/Widget.App.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:text="@string/silhouette_overlay_average" />

        </LinearLayout>

        <TextView
            android:id="@+id/clampCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:paddingHorizontal="16dp"
            android:text="@string/silhouette_clamp_caption"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/silhouette_warn"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 요약 한 줄 (3축 — 고른 축과 돌아오는 말이 같은지 여기서 보인다) -->
    <TextView
        android:id="@+id/axisSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingBottom="4dp"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/primary" />

    <!-- 조작부 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="45"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="12dp">

            <!-- 파트 배치 고지 (위치 폴백일 때만) -->
            <TextView
                android:id="@+id/mappingNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <!-- 부위·키·체중 행 (코드 생성) -->
            <LinearLayout
                android:id="@+id/rowsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 🎲 패널 -->
            <LinearLayout
                android:id="@+id/generatorHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/silhouette_editor_generator"
                    android:textAppearance="@style/TextAppearance.App.BodyStrong"
                    android:textColor="@color/primary" />

                <ImageView
                    android:id="@+id/generatorChevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/primary" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/generatorPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/body_gen_purpose"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="8dp" />

                <!-- 프리셋 (러프 경로) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/body_gen_preset"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:layout_marginBottom="2dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:id="@+id/presetRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- 키 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/body_gen_height"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:layout_marginBottom="2dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="8dp">

                    <RadioGroup
                        android:id="@+id/rgHeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- 몸통 축 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/body_gen_axis_torso"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:layout_marginBottom="2dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="8dp">

                    <RadioGroup
                        android:id="@+id/rgTorso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- 가슴 축 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/body_gen_axis_bust"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:layout_marginBottom="2dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="8dp">

                    <RadioGroup
                        android:id="@+id/rgBust"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- 힙 축 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/body_gen_axis_hip"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:layout_marginBottom="2dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="8dp">

                    <RadioGroup
                        android:id="@+id/rgHip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- 컵 지정 (가슴 축을 대신한다) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/body_gen_cup_mode"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/primary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchCupMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/cupSizeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <RadioGroup
                        android:id="@+id/rgCupSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- 상대 생성 -->
                <TextView
                    android:id="@+id/relativeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/body_gen_relative"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/spinnerBaseCharacter"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/relativeOptionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/body_gen_height_adjust"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:layout_marginBottom="2dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="8dp">

                        <RadioGroup
                            android:id="@+id/rgRelativeHeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/body_gen_volume_adjust"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:layout_marginBottom="2dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <RadioGroup
                            android:id="@+id/rgRelativeVolume"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                </LinearLayout>

                <!-- 작품 분포 -->
                <TextView
                    android:id="@+id/distributionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRoll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/body_gen_roll" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUndoRoll"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:enabled="false"
                        android:text="@string/body_gen_undo_roll" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 하단 고정 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="?attr/colorSurface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/apply" />

    </LinearLayout>

</LinearLayout>
