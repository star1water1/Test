<?xml version="1.0" encoding="utf-8"?>
<!--
  축 편집 창.

  **루트에 높이 상한이 붙어 있다(R-31 · B-171에서 고쳤다).** 종전에는 맨 LinearLayout이라
  스크롤이 아예 없었고, 이 창은 이름 · 겨루는 대상 · 기준 축 · 연결 셋 · 후보 필터 · 경고 셋을
  한 화면에 세운다 — **작은 화면에서는 아래쪽이 화면 밖으로 밀려 저장 버튼까지 닿지 않는다.**
  B-91·B-98이 닫은 것과 같은 결함인데 그 검사가 *루트가 ScrollView인 창*만 보고 있어
  **스크롤이 없는 창은 원리적으로 못 봤다**(같은 커밋에서 검사도 그 축을 갖췄다).
-->
<com.novelcharacter.app.ui.common.CappedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 목적문(R-25) — 축이 무엇이고 어디에 쓰이는지. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/duel_axis_name_purpose"
        android:textAppearance="@style/TextAppearance.App.BodySmall"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/editAxisName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/duel_axis_name_hint"
        android:inputType="text"
        android:importantForAutofill="no"
        android:singleLine="true" />

    <!-- ── 겨루는 대상 (설계 13장) ──
         만든 뒤에는 바꾸지 않는다(DuelAxis.targetType) — 바꾸면 쌓인 판의 참가자가 통째로
         뜻을 잃는다. 그래서 이 구역은 **새 축일 때만** 보인다. -->
    <LinearLayout
        android:id="@+id/targetSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/duel_axis_target_purpose"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/text_secondary" />

        <RadioGroup
            android:id="@+id/targetGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/targetCharacter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/duel_axis_target_character" />

            <RadioButton
                android:id="@+id/targetImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/duel_axis_target_image" />

        </RadioGroup>

    </LinearLayout>

    <!-- ── 기준 축 (B-104 소비처 ⓑ·ⓒ · 설계 13-5) ──
         이미지 축에만 뜻이 있어 그때만 보인다. 세계관당 하나이며, 켜면 형제 축의 표식이
         저장 시점에 내려간다(DuelRepository.saveAxis). -->
    <LinearLayout
        android:id="@+id/basisSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/duel_axis_basis_purpose"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/basisSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/duel_axis_basis_switch" />

        <TextView
            android:id="@+id/basisTakenNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ── 필드 연결 (층 C) ──
         이미지 축에는 뜻이 없어 통째로 감춘다 — 두 참가자가 같은 캐릭터의 그림이라
         어떤 필드값도 양쪽에 똑같이 뜬다(고르는 재료가 되지 않는다). -->
    <LinearLayout
        android:id="@+id/linkSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/duel_links_purpose"
        android:textAppearance="@style/TextAppearance.App.BodySmall"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/duel_links_influence_label"
                android:textAppearance="@style/TextAppearance.App.LabelSmall" />

            <TextView
                android:id="@+id/influenceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditInfluence"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duel_links_edit" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/duel_links_outcome_label"
                android:textAppearance="@style/TextAppearance.App.LabelSmall" />

            <TextView
                android:id="@+id/outcomeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditOutcome"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duel_links_edit" />

    </LinearLayout>

    <!-- 프로필 필드 (B-122) — 표시 전용이라 순위도 유리한 방향도 없다. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/duel_links_profile_label"
                android:textAppearance="@style/TextAppearance.App.LabelSmall" />

            <TextView
                android:id="@+id/profileSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditProfile"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duel_links_edit" />

    </LinearLayout>

    <!-- 후보 필터 (B-168) — "이 대결에선 여성끼리만"을 이 축에 저장한다. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/duel_filter_label"
                android:textAppearance="@style/TextAppearance.App.LabelSmall" />

            <TextView
                android:id="@+id/candidateFilterSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditCandidateFilter"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duel_links_edit" />

    </LinearLayout>

    <TextView
        android:id="@+id/linkConflictWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/error"
        android:visibility="gone" />

    <!--
      프로필로 걸렸지만 산출 필드라 카드에서 빠지는 것 — 고르는 창이 막지만 엑셀로 들어온
      파일은 그 창을 지나지 않는다. 조용히 빼지 않고 여기서 말한다(개발 의도 2번).
    -->
    <TextView
        android:id="@+id/profileBlockedWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!--
      산출로 걸린 시스템 열(B-167) — 고르는 창은 내지 않지만 엑셀은 그 창을 지나지 않는다.
      위 프로필 경고와 같은 근거로 여기 있다: 조용히 버리지도, 조용히 무시하지도 않는다.
    -->
    <TextView
        android:id="@+id/outcomeBlockedWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    </LinearLayout>

</LinearLayout>

</com.novelcharacter.app.ui.common.CappedScrollView>
