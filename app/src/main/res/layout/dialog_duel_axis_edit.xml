<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 목적문(R-25) — 축이 무엇이고 어디에 쓰이는지. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/duel_axis_name_purpose"
        android:textAppearance="@style/TextAppearance.App.BodySmall"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/editAxisName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/duel_axis_name_hint"
        android:inputType="text"
        android:importantForAutofill="no"
        android:singleLine="true" />

    <!-- ── 필드 연결 (층 C) ── -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/duel_links_purpose"
        android:textAppearance="@style/TextAppearance.App.BodySmall"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/duel_links_influence_label"
                android:textAppearance="@style/TextAppearance.App.LabelSmall" />

            <TextView
                android:id="@+id/influenceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditInfluence"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duel_links_edit" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/duel_links_outcome_label"
                android:textAppearance="@style/TextAppearance.App.LabelSmall" />

            <TextView
                android:id="@+id/outcomeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditOutcome"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duel_links_edit" />

    </LinearLayout>

    <TextView
        android:id="@+id/linkConflictWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/error"
        android:visibility="gone" />

</LinearLayout>
