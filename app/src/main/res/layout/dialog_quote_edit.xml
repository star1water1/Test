<?xml version="1.0" encoding="utf-8"?>
<!--
  명대사 편집 창 (사용자 요청 2026.08.20).

  칸이 셋인데 **필수는 대사 하나뿐**이다 — 상황과 출처는 나중에 채울 수 있어야 한다
  (원칙 04의 이중 경로: 러프하게 적고 뒤에 다듬는다).

  '쓰이는 자리'가 토글이 아니라 칩 줄인 것은 갈래가 셋이기 때문이다 — 일반·생일 전용·
  직접 적기. 직접 적기를 고를 때만 아래 칸이 뜬다(R-24 — 성립하지 않는 칸은 안 보인다).
-->
<com.novelcharacter.app.ui.common.CappedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutQuoteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/quote_text_label"
            app:counterEnabled="true"
            app:counterMaxLength="300">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editQuoteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:maxLines="6" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quote_occasion_label"
            android:textAppearance="@style/TextAppearance.App.LabelSmall"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/quote_occasion_purpose"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/quoteOccasionChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="false"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOccasionGeneral"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quote_occasion_general" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOccasionBirthday"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quote_occasion_birthday" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOccasionCustom"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quote_occasion_custom" />

        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutQuoteOccasion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/quote_occasion_custom_hint"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editQuoteOccasion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutQuoteNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/quote_note_label"
            app:helperText="@string/quote_note_hint"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editQuoteNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="2" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</com.novelcharacter.app.ui.common.CappedScrollView>
