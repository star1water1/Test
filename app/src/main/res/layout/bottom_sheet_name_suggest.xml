<?xml version="1.0" encoding="utf-8"?>
<!-- AI 이름 추천 시트 (B-123 · 설계 feature_roadmap 7장).
     목업 정본: docs/mockups/name_suggest_sheet_2026-08.html — 위에서부터
     ♥ 선반 / 최신 라운드 / 지난 라운드(접힘) 세 구역이고, 아래에 피드백 줄과 [은행에 담기]가 선다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.App.TitleLarge" />

        <!-- 다발 크기·창작도 — 매 라운드 쓰지 않는 설정이라 ⋮ 뒤에 둔다(원칙 04) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOptions"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:contentDescription="@string/ai_name_options"
            app:icon="@drawable/ic_more_vert" />

    </LinearLayout>

    <!-- 목적문 — "무엇이 어디서 어떻게" (새 기능 체크리스트 7 · R-25) -->
    <TextView
        android:id="@+id/purposeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/modeChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:singleLine="true"
        app:singleSelection="true"
        app:selectionRequired="true" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="200dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ⓐ ♥ 선반 — 어느 라운드 것이든 여기 모인다(상단 고정) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/shelfCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/shelfTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.LabelSmall"
                        android:textColor="@color/on_surface" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/shelfChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ⓑ 최신 라운드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/latestCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/latestTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.LabelSmall"
                        android:textColor="@color/on_surface" />

                    <LinearLayout
                        android:id="@+id/latestContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExpandLatest"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- 조용히 버린 것이 없음을 보인다 (R-14) — 토큰·드롭·되풀이·절단·실패 -->
                    <TextView
                        android:id="@+id/latestNotices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ⓒ 지난 라운드 — 라운드별로 접힌다 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pastCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_name_past_rounds"
                        android:textAppearance="@style/TextAppearance.App.LabelSmall"
                        android:textColor="@color/on_surface" />

                    <LinearLayout
                        android:id="@+id/pastContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="24dp"
                android:gravity="center"
                android:text="@string/ai_name_empty"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 피드백 줄 — 라운드마다 상태를 동봉해 다시 요청한다(멀티턴 없이, 설계 7-2) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/ai_name_instruction_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/instructionEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="2" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMore"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp" />

    </LinearLayout>

    <!-- 다음 라운드가 무엇을 싣는지 실행 전에 말한다 (비용 고지 + 상태 고지) -->
    <TextView
        android:id="@+id/costText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/depositNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeposit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp" />

    </LinearLayout>

</LinearLayout>
