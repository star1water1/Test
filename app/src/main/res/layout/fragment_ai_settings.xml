<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/ai_settings_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_settings_intro"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ai_settings_security_note"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Section: 등록된 프로바이더 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_settings_providers_section"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:paddingTop="20dp"
                android:paddingBottom="4dp" />

            <!-- 목적문 (R-25) — 무엇이 어디서 어떻게 되는가. 자동 전환은 사용자가 켠 적
                 없는데 결과가 다른 모델에서 오는 일이라, 규칙을 여기서 미리 말해 둔다. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/ai_settings_providers_order_note"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:gravity="center"
                android:text="@string/ai_settings_empty"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/providerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addProviderButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ai_settings_add_provider" />

            <!-- Section: AI 추천 일관성 — 프롬프트에 무엇을 얼마나 실을지.
                 일관성과 토큰은 교환 관계이고 그 교환비는 데이터 규모·모델·과금마다 다르므로
                 개발자가 정하지 않고 사용자가 정한다(자율성 우선). 0 = 끔. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_settings_consistency_section"
                android:textAppearance="@style/TextAppearance.App.BodySmall"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:paddingTop="24dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/ai_settings_consistency_intro"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/stats_margin_md"
                app:cardCornerRadius="@dimen/stats_card_corner_radius"
                app:cardElevation="@dimen/stats_card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ai_settings_usage_examples"
                            android:textAppearance="@style/TextAppearance.App.BodyStrong" />

                        <TextView
                            android:id="@+id/usageExamplesValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textAppearance="@style/TextAppearance.App.BodyStrong"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/usageExamplesSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="2"
                        android:valueFrom="0"
                        android:valueTo="24" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_settings_usage_examples_hint"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/usageExamplesCost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 사건 AI 재료 범위 (B-43) — 켤 것을 사용자가 고른다(확정 16번). 저장 버튼 없음(원칙 04) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/stats_margin_md"
                app:cardCornerRadius="@dimen/stats_card_corner_radius"
                app:cardElevation="@dimen/stats_card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_settings_event_scope"
                        android:textAppearance="@style/TextAppearance.App.BodyStrong" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/ai_settings_event_scope_desc"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:id="@+id/eventScopeContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/eventScopeEmptyNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/ai_settings_event_scope_empty"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 받아올 근거 강도 — 슬라이더가 아니라 택일이라 RadioGroup. 저장 버튼 없음(원칙 04) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/stats_margin_md"
                app:cardCornerRadius="@dimen/stats_card_corner_radius"
                app:cardElevation="@dimen/stats_card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_settings_confidence"
                        android:textAppearance="@style/TextAppearance.App.BodyStrong" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ai_settings_confidence_hint"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <RadioGroup
                        android:id="@+id/confidenceGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/confidenceAll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_settings_confidence_all" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/confidenceMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_settings_confidence_medium" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/confidenceHigh"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_settings_confidence_high" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 창작도 (A-4) — 값의 후보 공간을 넓히되 계약(설명·옵션·형식·허용 목록)은 넓히지 않는다 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/stats_margin_md"
                app:cardCornerRadius="@dimen/stats_card_corner_radius"
                app:cardElevation="@dimen/stats_card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_creativity_label"
                        android:textAppearance="@style/TextAppearance.App.BodyStrong" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ai_settings_creativity_hint"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <RadioGroup
                        android:id="@+id/creativityGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/creativityPrecise"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_creativity_precise_desc" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/creativityBalanced"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_creativity_balanced_desc" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/creativityFree"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_creativity_free_desc" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/creativityBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_creativity_bold_desc" />
                    </RadioGroup>

                    <!-- §6-4 — 프로토콜 상한 차이(자유·실험이 좁은 프로바이더)를 숨기지 않는다 -->
                    <TextView
                        android:id="@+id/creativityProtocolNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/ai_creativity_narrow_range_note"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="gone" />

                    <!-- AI 이미지 태그 기조 (설계 image_folder_tag_ai 4-1) — R-25 목적문 포함 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/ai_image_tag_policy_label"
                        android:textAppearance="@style/TextAppearance.App.Subtitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/ai_image_tag_policy_desc"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/ai_image_tag_policy_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/imageTagPolicyEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2"
                            android:maxLines="5"
                            android:gravity="top"
                            android:textAppearance="@style/TextAppearance.App.Body" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/stats_card_corner_radius"
                app:cardElevation="@dimen/stats_card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ai_settings_style_samples"
                            android:textAppearance="@style/TextAppearance.App.BodyStrong" />

                        <TextView
                            android:id="@+id/styleSamplesValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textAppearance="@style/TextAppearance.App.BodyStrong"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/styleSamplesSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:valueFrom="0"
                        android:valueTo="3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_settings_style_samples_hint"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/styleSamplesCost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorPrimary" />

                    <!-- AI에 함께 보낼 이미지 (A-7) — 적재량 슬라이더의 형제다.
                         같은 카드에 두는 이유: 셋 다 "요청에 무엇을 얼마나 싣는가"이고,
                         나누면 사용자가 비용을 세 자리에서 따로 재게 된다. -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ai_attach_images_label"
                            android:textAppearance="@style/TextAppearance.App.BodyStrong" />

                        <TextView
                            android:id="@+id/attachImagesValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textAppearance="@style/TextAppearance.App.BodyStrong"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/attachImagesSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:valueFrom="0"
                        android:valueTo="10" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_attach_images_desc"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/attachRepresentativeSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ai_attach_representative_label" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_attach_representative_desc"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ai_settings_usage_note"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
