<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- 드래그 핸들 -->
        <ImageView
            android:id="@+id/dragHandle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_drag_handle"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/drag_handle_desc" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/fieldName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Subtitle"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/fieldTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@color/primary" />

                <TextView
                    android:id="@+id/fieldSemanticBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:textColor="@color/primary"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:visibility="gone" />

                <!-- 전역 기본 필드에서 심긴 필드 (B-119) — 일일이 열어 보지 않아도
                     이 필드가 어디서 왔는지 목록에서 보인다(원칙 04) -->
                <TextView
                    android:id="@+id/fieldDefaultBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/default_field_badge"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:textColor="@color/primary"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/fieldKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/text_secondary"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/fieldGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/primary" />

        </LinearLayout>

        <!-- 필드 설명(A-2) — 설명이 있는 필드에만 보인다 (빈 다이얼로그를 여는 버튼은 구색) -->
        <ImageButton
            android:id="@+id/btnFieldInfo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_info"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:contentDescription="@string/field_description_info_desc" />

        <!--
          AI 추천 대상(A-1). B-80으로 3단이 되어 스위치로는 담을 수 없다 —
          현재 상태를 라벨로 띄우는 버튼 1탭 → 메뉴 1탭으로 바꾼다.
          목록의 값어치가 '한눈에 조감'이라 상태가 글자로 보여야 한다. 사건 필드에는 노출하지 않는다(R-24).
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAiMode"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/field_ai_suggest_label" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
