<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/titleLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/novel_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/novel_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/borderColorLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/border_color_label"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/border_color_desc_novel"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" />

        <View
            android:id="@+id/colorPreview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@color/item_background_light" />

        <LinearLayout
            android:id="@+id/colorPresetsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:hint="@string/border_color_hex_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editBorderColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/resetBorderColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/border_color_reset"
                android:textColor="@color/primary"
                android:paddingEnd="16dp" />

            <TextView
                android:id="@+id/btnFullSpectrum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color_picker_full_spectrum"
                android:textColor="@color/primary" />

        </LinearLayout>

        <!-- 표준 년도 -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:hint="@string/standard_year_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editStandardYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/standard_year_description"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <!-- 이미지 설정 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/image_mode_label"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/image_mode_desc_novel"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerImageMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/image_mode_label" />

        <TextView
            android:id="@+id/btnSelectImage"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/image_select"
            android:textColor="@color/primary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/imageRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnSelectCharacter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/image_select_character"
            android:textColor="@color/primary"
            android:visibility="gone" />

        <!-- 작품 커스텀 필드 (확-3) — 이 작품이 속한 세계관의 작품 필드로 동적 구성 -->
        <TextView
            android:id="@+id/novelFieldSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="@string/novel_custom_fields"
            android:textColor="@color/primary"
            android:textAppearance="@style/TextAppearance.App.BodyStrong"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/novelFieldContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!--
          필드가 0개일 때도 머리글과 함께 남는 안내 + 만드는 경로 (P5가 사건에서 세운 규약).
          섹션을 통째로 감추면 작품을 쓰는 자리에서 '작품 필드'의 존재 신호가 없고,
          만들려면 세계관 목록까지 되돌아가야 한다 — 빈 상태에서 교정 경로를 없애지 않는다.
        -->
        <TextView
            android:id="@+id/novelFieldEmptyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/novel_field_empty_hint"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddNovelField"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/novel_field_add"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
