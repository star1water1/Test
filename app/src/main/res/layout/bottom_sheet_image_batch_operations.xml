<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@color/text_secondary" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:textAppearance="@style/TextAppearance.App.TitleLarge"
            tools:text="선택한 이미지 3장" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/opAssign"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/image_assign_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/opTagAdd"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/batch_tag_add_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/opTagRemove"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/batch_tag_remove_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/opLink"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/image_link_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/opUnlink"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/image_unlink_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/opUnassign"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/image_unassign_action" />

        <!-- 서랍에서 빼기(B-107) — '배정 해제' 바로 아래다. 뗀 표식을 붙이는 조작의 짝이라
             나란히 있어야 붙이고 떼는 한 쌍으로 읽힌다. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/opClearDetached"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/image_manager_clear_detached_mark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/opRecompress"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/image_manager_recompress" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/opDelete"
            style="@style/Widget.App.Button.Outlined.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="@string/delete" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
